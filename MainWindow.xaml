                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                ItemsSource="{Binding DataContext.WaveTypes, ElementName=Root}"
                SelectedItem="{Binding tertiaryWaveType, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="Flag Progression Template" HorizontalAlignment="Left" Margin="10,21,0,0" VerticalAlignment="Top" Width="155" Height="26"/>
        <Label Content="Wave Unit Grouping" HorizontalAlignment="Left" Margin="10,405,0,0" VerticalAlignment="Top" Width="155" Height="26"/>
        <Button Content="Export Flag Data" HorizontalAlignment="Left" Margin="1079,52,0,0" VerticalAlignment="Top" Height="27" Width="111" Click="ExportFlagData_Click"/>
        <Button Content="Import Flag Data" HorizontalAlignment="Left" Margin="851,52,0,0" VerticalAlignment="Top" Height="27" Width="107" Click="ImportFlagData_Click"/>
        <Button Content="Validate Flag Data" HorizontalAlignment="Left" Margin="963,52,0,0" VerticalAlignment="Top" Height="27" Width="111" Visibility="Hidden"/>
        <Button Content="Import Unit Data" HorizontalAlignment="Left" Margin="852,84,0,0" VerticalAlignment="Top" Height="27" Width="106" Click="ImportUnitData_Click"/>
        <Button Content="Validate Unit Data" HorizontalAlignment="Left" Margin="963,84,0,0" VerticalAlignment="Top" Height="27" Width="111" Visibility="Hidden"/>
        <Button Content="Export Unit Data" HorizontalAlignment="Left" Margin="1079,84,0,0" VerticalAlignment="Top" Height="27" Width="111" Click="ExportUnitData_Click"/>
        <ComboBox x:Name="waveType_cbo" HorizontalAlignment="Left" Margin="969,116,0,0" VerticalAlignment="Top" Width="221" Height="27" ItemsSource="{Binding LevelTypes}" SelectedItem="{Binding SelectedWaveType, Mode=TwoWay}"/>
        <Label Content="Level Setting" HorizontalAlignment="Left" Margin="867,117,0,0" VerticalAlignment="Top" Width="91"/>
        <Label Content="Font size (to see unit images better)" HorizontalAlignment="Left" Margin="165,405,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.266,-0.247" Width="203"/>
        <TextBox x:Name="PresetTextSize" HorizontalAlignment="Left" Margin="373,405,0,0" TextWrapping="Wrap" Text="24" VerticalAlignment="Top" Width="125" Height="26" VerticalContentAlignment="Center" />
    </Grid>
</Window>
