        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TKIW_RunBuilder"
        xmlns:vm="clr-namespace:TKIW_RunBuilder.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1225">
    <Grid>
        <Grid.Resources>
            <local:ImageUriToBitmapConverter x:Key="ImageConverter" />
            <!-- DropDownClosed is not a routed event so EventSetter cannot be used. Handlers are attached directly on ComboBox elements. -->
            <DataTemplate x:Key="UnitComboItemTemplate">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding imageSource, Converter={StaticResource ImageConverter}}" Width="{Binding Text, ElementName=PresetTextSize}" Height="{Binding Text, ElementName=PresetTextSize}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="unit_1" Text="{Binding displayName}" VerticalAlignment="Center" FontSize="{Binding Text, ElementName=PresetTextSize}"/>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
