            </DataGrid.Columns>
        </DataGrid>
        <DataGrid x:Name="TemplateTbl" Margin="10,52,0,287" AutoGenerateColumns="False" ItemsSource="{Binding WaveTemplates}" AddingNewItem="Template_AddingNewItem" Width="838" HorizontalAlignment="Left" VerticalAlignment="Top" Height="320" CanUserDeleteRows="True" SelectionUnit="FullRow" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Week" Binding="{Binding week}"/>
                <DataGridTextColumn Header="Req Unit Group(s)" Binding="{Binding reqWaveId}"/>
                <DataGridTextColumn Header="Extra Unit Group(s)" Binding="{Binding extraWaveId_1}"/>
                <DataGridTextColumn Header="Extra Unit Group(s)" Binding="{Binding extraWaveId_2}"/>
                <DataGridTemplateColumn Header="Wave Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding waveType}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding DataContext.WaveTypes, ElementName=Root}"
                                SelectedItem="{Binding waveType, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Secondary Wave Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding secondaryWaveType}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                ItemsSource="{Binding DataContext.WaveTypes, ElementName=Root}"
                SelectedItem="{Binding secondaryWaveType, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Tertiary Wave Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
