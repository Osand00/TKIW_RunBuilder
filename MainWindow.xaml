                                <Image Source="{Binding unit_1.imageSource, Converter={StaticResource ImageConverter}}" Width="{Binding Text, ElementName=PresetTextSize}" Height="{Binding Text, ElementName=PresetTextSize}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding unit_1.displayName}" VerticalAlignment="Center" FontSize="{Binding Text, ElementName=PresetTextSize}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding DataContext.Units, ElementName=Root}"
                                ItemTemplate="{StaticResource UnitComboItemTemplate}"
                                SelectedItem="{Binding unit_1, Mode=TwoWay}"
                                VirtualizingStackPanel.IsVirtualizing="True"
                                VirtualizingStackPanel.VirtualizationMode="Recycling"
                                ScrollViewer.CanContentScroll="True"
                                DropDownClosed="ComboBox_DropDownClosed">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Qty" Binding="{Binding qty_1}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Unit">
