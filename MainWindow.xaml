            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Unit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
